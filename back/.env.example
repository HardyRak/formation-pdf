# ============================================================
# PDF Formation — Backend (NestJS + MongoDB)
# Copier ce fichier en `.env` et adapter les valeurs.
# Le `.env` n'est JAMAIS commité (voir .gitignore).
# ============================================================

# --- Serveur -------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base de données MongoDB (variables séparées) -------------
# L'URI de connexion est construite automatiquement à partir de ces variables :
#   mongodb://[MONGO_USER:MONGO_PASSWORD@]MONGO_HOST:MONGO_PORT/MONGO_DB[?authSource=MONGO_AUTH_SOURCE]
# Laissez MONGO_USER/MONGO_PASSWORD vides pour une base locale sans authentification.
#
# NOTE : docker-compose.yml lit ce même fichier `.env`. Dans les conteneurs,
# MONGO_HOST est forcé à « mongo » (nom du service) ; la valeur ci-dessous ne
# sert donc que pour un lancement du backend depuis la machine hôte.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=pdf-formation
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# --- Authentification (JWT) ----------------------------------
# Secret de signature (>= 16 caractères). À changer en production.
JWT_SECRET=change-me-in-production
# Durée de vie du jeton d'accès en secondes (15 minutes)
JWT_ACCESS_TTL=900
# Durée de vie du jeton de rafraîchissement en secondes (7 jours)
JWT_REFRESH_TTL=604800

# --- CORS (origines autorisées, séparées par des virgules) ---
# Ex. Expo web (dev) + un éventuel back-office.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
