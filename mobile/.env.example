# ============================================================
# PDF Formation — Application mobile (Expo)
# Copier ce fichier en `.env` (jamais commité) et adapter.
# Expo charge automatiquement `.env` au démarrage.
# ============================================================

# --- API -----------------------------------------------------
# Mode de transport du client HTTP :
#   remote → requêtes HTTP vers l'API NestJS (back/)
#   mock   → backend simulé embarqué (aucun serveur requis, mode démo)
EXPO_PUBLIC_API_MODE=remote

# URL de base de l'API (préfixe /v1 inclus).
#   Simulateur iOS        : http://localhost:3000/v1
#   Émulateur Android     : http://10.0.2.2:3000/v1
#   Appareil physique     : http://<IP_LAN_DE_VOTRE_MACHINE>:3000/v1
#   Web (expo start --web): http://localhost:3000/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# --- Lecteur PDF -------------------------------------------------
# Taille maximale (Mo) d'un PDF conservé en mémoire par le lecteur NATIF
# (promesse : aucun fichier stocké sur l'appareil). Au-delà : erreur explicite
# DOCUMENT_TOO_LARGE. Sans effet sur web (Blob URL). Défaut : 30.
EXPO_PUBLIC_READER_MAX_MEMORY_MB=30
