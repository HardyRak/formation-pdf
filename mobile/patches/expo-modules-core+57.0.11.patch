diff --git a/node_modules/expo-modules-core/android/build.gradle b/node_modules/expo-modules-core/android/build.gradle
index 4d86742..aaf234c 100644
--- a/node_modules/expo-modules-core/android/build.gradle
+++ b/node_modules/expo-modules-core/android/build.gradle
@@ -71,6 +71,13 @@ if (workletsProject != null) {
     println("Linking react-native-worklets native libs into expo-modules-core build tasks")
     println(workletsProject.tasks.getByName("mergeDebugNativeLibs"))
     println(workletsProject.tasks.getByName("mergeReleaseNativeLibs"))
+    // Force the worklets native library to be compiled BEFORE expo-modules-core's CMake build.
+    // react-native-worklets ships libworklets.so through prefab (build/intermediates/cxx/...),
+    // so depending only on mergeDebugNativeLibs can let buildCMakeDebug race ahead and fail with:
+    //   ninja: error: .../react-native-worklets/android/build/intermediates/cxx/.../libworklets.so ... missing and no known rule to make it
+    // This mirrors the ordering that react-native-reanimated applies upstream (see its build.gradle.kts).
+    tasks.getByName("buildCMakeDebug").dependsOn(workletsProject.tasks.getByName("externalNativeBuildDebug"))
+    tasks.getByName("buildCMakeRelWithDebInfo").dependsOn(workletsProject.tasks.getByName("externalNativeBuildRelease"))
     tasks.getByName("buildCMakeDebug").dependsOn(workletsProject.tasks.getByName("mergeDebugNativeLibs"))
     tasks.getByName("buildCMakeRelWithDebInfo").dependsOn(workletsProject.tasks.getByName("mergeReleaseNativeLibs"))
   }
