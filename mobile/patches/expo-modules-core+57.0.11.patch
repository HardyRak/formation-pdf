diff --git a/node_modules/expo-modules-core/android/build.gradle b/node_modules/expo-modules-core/android/build.gradle
index 4d86742..f02068a 100644
--- a/node_modules/expo-modules-core/android/build.gradle
+++ b/node_modules/expo-modules-core/android/build.gradle
@@ -71,8 +71,23 @@ if (workletsProject != null) {
     println("Linking react-native-worklets native libs into expo-modules-core build tasks")
     println(workletsProject.tasks.getByName("mergeDebugNativeLibs"))
     println(workletsProject.tasks.getByName("mergeReleaseNativeLibs"))
-    tasks.getByName("buildCMakeDebug").dependsOn(workletsProject.tasks.getByName("mergeDebugNativeLibs"))
-    tasks.getByName("buildCMakeRelWithDebInfo").dependsOn(workletsProject.tasks.getByName("mergeReleaseNativeLibs"))
+    // Force the worklets native library to be compiled BEFORE expo-modules-core's CMake build.
+    // libworklets.so is published through prefab (build/intermediates/cxx/...). Depending only on
+    // mergeDebugNativeLibs (the legacy wiring) can let the ninja build race ahead and fail with:
+    //   ninja: error: .../react-native-worklets/android/build/intermediates/cxx/.../libworklets.so ... missing and no known rule to make it
+    // The ninja run happens in the per-ABI leaf tasks (ex. buildCMakeDebug[x86_64]) AND the umbrella
+    // externalNativeBuild<Variant> task, so we attach dependsOn(...) to every matching task via
+    // configureEach. This mirrors the ordering that react-native-reanimated applies upstream
+    // (see its build.gradle.kts) but covers all CMake tasks of this project.
+    def workletsDebug = workletsProject.tasks.getByName("externalNativeBuildDebug")
+    def workletsRelease = workletsProject.tasks.getByName("externalNativeBuildRelease")
+    tasks.configureEach {
+      if (name.startsWith("buildCMakeDebug") || name.startsWith("externalNativeBuildDebug")) {
+        dependsOn(workletsDebug)
+      } else if (name.startsWith("buildCMakeRelWithDebInfo") || name.startsWith("buildCMakeRelease") || name.startsWith("externalNativeBuildRelease")) {
+        dependsOn(workletsRelease)
+      }
+    }
   }
 }
 
